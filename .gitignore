# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── PyInstaller / packaging ───────────────────────────────────────
build/
dist/
# Google's Android platform-tools, unzipped here before a release
# build (see docs/BUILD_RELEASE.md). A third-party download with
# its own licence — carried into the package, never into the repo.
platform-tools/
release/
*.spec.bak
*.manifest
AppDir/
squashfs-root/
appimagetool*.AppImage
installer-output/
# The WebView2 bootstrapper is downloaded during the build; never committed
packaging/windows/redist/

# ── application output ────────────────────────────────────────────
# Logs are written to the user's directory; this guards against a stray copy
*.log
*.log.[0-9]
# Filled-in checklists (the file in the repository is the empty template)
Field_Device_Verification_set*.xlsx

# ── sensitive files ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
# Digests of service keys written from this checkout, so a source run
# recognises them (panel/adminkey/secret.py). Local, never released.
.adminkey-dev.json
.adminkey-dev.tmp
# THE BUILD SECRET ITSELF, when it is kept here to raise a source run to
# admin mode without restarting. Never committed, never packaged: a frozen
# build does not read it (panel/adminkey/secret.py).
.adminkey-secret
*.p12
*.pfx
id_rsa*
secrets.*

# ── operating system ──────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# ── editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# Written by dabp.spec at build time; never committed (see the spec).
panel/editions/_stamp.py
